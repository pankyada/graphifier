            "type": "string",
            "title": "Repo Id"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "expression": {
            "type": "string",
            "title": "Expression"
          },
          "default_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Value"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          }
        },
        "type": "object",
        "required": [
          "repo_id",
          "environment",
          "symbol",
          "expression"
        ],
        "title": "ResolutionIn"
      },
      "TransitionIn": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          }
        },
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "TransitionIn"
      },
