{
  "name": "graphifier",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed repository and data lineage explorer",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3011",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3011",
    "typecheck": "tsc --noEmit",
    "setup:backend": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "api": "./scripts/api.sh",
    "api:dev": "./scripts/api.sh --reload --reload-dir backend/graphifier",
    "worker": "./scripts/worker.sh"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
