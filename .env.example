# Copy to .env.local. Existing exported variables take precedence.
# Default repository root is this project's examples/ directory.
# Set an absolute directory to browse your own repositories.
# GRAPHIFIER_REPO_ROOT=/absolute/path/to/repositories

# Local API address used only by the Next.js server.
GRAPHIFIER_API_URL=http://127.0.0.1:8787
GRAPHIFIER_API_PORT=8787

# Use a stable name for the physical system this workspace describes.
# Identical qualified names in this system + environment can connect.
GRAPHIFIER_SYSTEM=local-workspace
# GRAPHIFIER_DB=/absolute/path/to/graphifier.sqlite3
# Optional shared token for direct agent API access; keep server-side.
# GRAPHIFIER_API_TOKEN=

# Only used when a job explicitly enables AI analysis.
# OPENAI_API_KEY=
GRAPHIFIER_AGENT_MODEL=gpt-6-luna
# Official OpenAI defaults: harness Low, architecture grouping Luna High.
# Custom endpoints inherit the harness profile for grouping unless overridden.
# GRAPHIFIER_AGENT_REASONING_EFFORT=low
# GRAPHIFIER_HIERARCHY_MODEL=gpt-6-luna
# GRAPHIFIER_HIERARCHY_REASONING_EFFORT=high
GRAPHIFIER_AGENT_TIMEOUT=60
GRAPHIFIER_AGENT_API=responses
# 0 disables the AI file/step cap. Set positive values to bound a run.
GRAPHIFIER_AGENT_MAX_FILES=0
GRAPHIFIER_AGENT_MAX_STEPS=0
# Set GRAPHIFIER_AGENT_API=chat_completions for compatible chat endpoints.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional graph projection. Local exploration works without Neo4j.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Explicit scan budgets. Exceeding a budget fails without publishing partial results.
GRAPHIFIER_MAX_FILES=100000
GRAPHIFIER_MAX_SOURCE_BYTES=1000000000
GRAPHIFIER_MAX_FILE_BYTES=5000000

# Optional embeddings. Configure a model, then opt in on each analysis job.
# GRAPHIFIER_EMBEDDING_MODEL=text-embedding-3-small
# GRAPHIFIER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# GRAPHIFIER_EMBEDDING_API_KEY=
GRAPHIFIER_EMBEDDING_BATCH_SIZE=16

# Optional additional enterprise Git hosts for remote repository import.
# GRAPHIFIER_GIT_HOSTS=github.example.com,bitbucket.example.com
GRAPHIFIER_CLONE_TIMEOUT=1800

# Optional AI grouping call cap per analysis (0 = unlimited total bounded requests)
GRAPHIFIER_AI_HIERARCHY_MAX_BATCHES=0
